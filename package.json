{
  "name": "rubric-near",
  "version": "0.1.0",
  "private": true,
  "description": "Rubric on NEAR: pay on proof, not on trust. Sealed acceptance clauses, an AI judge, and a NEAR escrow that releases funds on the verdict.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "judge",
    "agents",
    "demo",
    "web"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sandbox:install": "npm --prefix sandbox install",
    "demo:sandbox": "npm --prefix sandbox run demo",
    "test:sandbox": "npm --prefix sandbox test",
    "demo:testnet": "npm run demo:testnet -w demo",
    "judge": "npm run judge -w judge --",
    "dashboard": "npm start -w web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

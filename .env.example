# Copy this file to .env and fill it in. NEVER commit .env: it is git-ignored on purpose.
# Everything here is for NEAR TESTNET. Nothing in this repository is meant to guard real money.

# --- The deployed escrow contract and the judge's account ---------------------------------------
RUBRIC_CONTRACT=
JUDGE_ACCOUNT=

# The judge's secret key ("ed25519:..."). Leave it empty to have it read from the credentials file
# the NEAR CLI wrote: ~/.near-credentials/testnet/<JUDGE_ACCOUNT>.json
JUDGE_PRIVATE_KEY=

# Defaults to https://test.rpc.fastnear.com
NEAR_RPC_URL=

# --- The judge -----------------------------------------------------------------------------------
# "mock" is an offline rule, NOT a language model: it needs no key and no network, so the whole loop
# can be run anywhere. "near-ai" uses a model on NEAR AI Cloud and needs NEAR_AI_API_KEY.
JUDGE_MODE=mock
NEAR_AI_API_KEY=
# Any model from https://cloud-api.near.ai/v1/model/list
NEAR_AI_MODEL=anthropic/claude-sonnet-5-5

# A verdict below this confidence is held for a human instead of settling. The contract refuses
# anything under 70 regardless, so a lower value here has no effect.
CONFIDENCE_THRESHOLD=70

PORT=8787
# Where the judge keeps each verdict's full reasoning (the text whose hash is on-chain).
VERDICT_DIR=.data/verdicts
